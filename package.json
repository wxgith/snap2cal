{
  "name": "snap2cal",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "A browser-local tool for turning event text, screenshots, timetables, and shift rosters into reviewable ICS calendar files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxgith/snap2cal.git"
  },
  "bugs": {
    "url": "https://github.com/wxgith/snap2cal/issues"
  },
  "homepage": "https://wxgith.github.io/snap2cal/",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify:multi-event": "vitest run src/multi-event src/ics/index.test.ts src/MultiEvent.test.tsx src/ImageMode.test.tsx",
    "verify:schedule-table": "node scripts/verify-schedule-table.mjs",
    "verify:shift-roster": "node scripts/verify-shift-roster.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "verify:ocr": "node scripts/verify-ocr-assets.mjs",
    "generate:license-report": "node scripts/generate-license-report.mjs",
    "validate:repo": "node scripts/validate-repo.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "validate:runtime-network": "node scripts/validate-runtime-network.mjs",
    "validate:production-mocks": "node scripts/validate-production-mocks.mjs",
    "verify:pages-base": "node scripts/verify-pages-base.mjs",
    "capture:demo": "node scripts/capture-demo-screenshots.mjs",
    "test:cross-browser": "node scripts/run-cross-browser.mjs",
    "test:a11y": "node scripts/run-a11y.mjs",
    "package:release": "node scripts/package-release.mjs",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fflate": "0.8.3",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "@vitejs/plugin-react": "latest",
    "yaml": "2.9.0",
    "vitest": "latest"
  }
}
